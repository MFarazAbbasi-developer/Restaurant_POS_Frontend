# FARMAX POS Frontend Environment Variables

# API base URL for restaurant POS backend service
VITE_API_BASE_URL=http://localhost:5000/api/v1

# WebSocket base URL for real-time order updates, KDS syncing, and table statuses
VITE_WS_URL=http://localhost:5000

# Application environment (development | staging | production)
VITE_APP_ENV=development

# Application branding / terminal default identification
VITE_APP_NAME="FARMAX POS"
VITE_APP_VERSION="0.1.0"
VITE_DEFAULT_TERMINAL_ID="POS-MAIN-01"

# Product & Developer Identity Attribution (Dummy placeholder values)
VITE_DEVELOPER_NAME="Your Name"
VITE_DEVELOPER_PHONE="+1 555 0199"
VITE_DEVELOPER_EMAIL="developer@example.com"
VITE_DEVELOPER_WEBSITE="https://example.com"

# Receipt Attribution
VITE_RECEIPT_ATTRIBUTION_ENABLED=true
VITE_RECEIPT_ATTRIBUTION_SHOW_PHONE=true
VITE_RECEIPT_ATTRIBUTION_TEXT="Powered by FARMAX POS · Developed by Developer Name"

# Opt-in only: show Quick Staff demo presets on login (for local demo-seed testing).
# Leave unset/false for customer installs so seeded demo credentials are not suggested.
# VITE_ENABLE_DEMO_LOGIN_PRESETS=true
